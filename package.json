{
  "name": "smart-phr-client",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:up": "docker compose up -d && node scripts/wait-for-mysql.mjs && node scripts/migrate-db.js && node scripts/seed-demo-user.js",
    "db:down": "docker compose down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^9.0.1",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^9.15.1",
    "h3": "^1.12.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "node-fetch": "^3.3.2",
    "nuxt": "^3.12.4",
    "vue": "latest"
  }
}
