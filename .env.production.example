# 复制为 .env 后用于 docker compose -f docker-compose.prod.yml up -d

# 对外访问 URL（必须 HTTPS 若使用 Google OAuth 生产环境）
APP_URL=https://phr.example.com
APP_DOMAIN=phr.example.com
CADDY_EMAIL=you@example.com

# 强随机字串（openssl rand -hex 32）
JWT_SECRET=change-me-to-a-random-secret

# Google OAuth — redirect URI 须为 ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FHIR_SERVER_URL=https://hapi.fhir.org/baseR4
DEMO_FHIR_PATIENT_ID=3935

MYSQL_PASSWORD=strong-mysql-password-here
MYSQL_DATABASE=FHIR_Appointment_Medicine

# CI/CD 部署时使用 GHCR 镜像（本地 build 可省略）
# APP_IMAGE=ghcr.io/frankshicar/smart-phr-client:latest
